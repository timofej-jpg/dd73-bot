@dp.callback_query(BookingState.waiting_for_service)
async def process_service_choice(callback: CallbackQuery, state: FSMContext):
    srv_name = callback.data.replace("srv_", "")
    data = await state.get_data()
    car_key = data['car_key']

    # Пошук ціни
    price = "за запитом"
    for cat in PRICES.values():
        if srv_name in cat:
            price = cat[srv_name].get(car_key, "за запитом")
            break

    await state.update_data(selected_service=srv_name, selected_price=price)
    await callback.answer()

    dates = get_available_dates()
    buttons = [[InlineKeyboardButton(text=label, callback_data=f"date_{d_str}")] for d_str, label in dates]
    kb = InlineKeyboardMarkup(inline_keyboard=buttons)
    
    await state.set_state(BookingState.waiting_for_date)
    await callback.message.answer(f"Обрано: **{srv_name}** ({price})\nОберіть день для візиту:", reply_markup=kb, parse_mode="Markdown")

@dp.callback_query(BookingState.waiting_for_date)
